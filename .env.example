# demo: offline LangGraph workflow; live: LangChain model + real tool calling.
SUPPORTFLOW_AGENT_MODE=demo
# auto detects api.deepseek.com; alternatives: deepseek / openai-compatible.
SUPPORTFLOW_MODEL_PROVIDER=auto
SUPPORTFLOW_HOST=127.0.0.1
SUPPORTFLOW_PORT=8010
SUPPORTFLOW_SEED_DEMO=true
# Docker Compose requires a non-empty PostgreSQL password (local SQLite needs none).
POSTGRES_PASSWORD=
# Default database: data/supportflow.db. Optional PostgreSQL:
# SUPPORTFLOW_DATABASE_URL=postgresql+psycopg://supportflow:password@localhost:5432/supportflow
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Optional dedicated OpenAI-compatible endpoint; these override DEEPSEEK_*.
# SUPPORTFLOW_API_KEY=
# SUPPORTFLOW_BASE_URL=
# SUPPORTFLOW_MODEL=

# Keyword retrieval is the default and does not download models.
SUPPORTFLOW_RETRIEVAL_MODE=bm25
# Optional: install .[vector], start an OpenAI-compatible embedding service,
# then select hybrid or vector. DeepSeek chat credentials are not reused here.
# Example for a separately prepared local Ollama bge-m3 model:
# SUPPORTFLOW_EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# SUPPORTFLOW_EMBEDDING_MODEL=bge-m3
# SUPPORTFLOW_EMBEDDING_API_KEY=
# SUPPORTFLOW_VECTOR_MIN_SIMILARITY=0.35
# Docker optional extra: postgres,vector (default is postgres).
# SUPPORTFLOW_PYTHON_EXTRAS=postgres,vector
